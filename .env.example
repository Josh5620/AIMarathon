# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (Project Settings → Database → Connection string → URI mode)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── AI provider (OpenAI-compatible) ─────────────────────────────────────────
# Only these 5 vars change between providers.
# After switching providers: DROP TABLE candidates; re-run db/schema.sql with the new VECTOR(N).

# --- Option A: Google Gemini — FREE, no credit card (RECOMMENDED for dev) ---
# Get key at: https://aistudio.google.com → "Get API key"
CHUTES_API_KEY=AIza...
CHUTES_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHUTES_EMBED_MODEL=gemini-embedding-001
CHUTES_CHAT_MODEL=gemini-2.5-flash
EMBED_DIM=3072

# --- Option B: Mistral AI — free tier, OpenAI-compatible ---
# Get key at: https://console.mistral.ai
# CHUTES_API_KEY=...
# CHUTES_BASE_URL=https://api.mistral.ai/v1
# CHUTES_EMBED_MODEL=mistral-embed
# CHUTES_CHAT_MODEL=mistral-small-latest
# EMBED_DIM=1024

# --- Option C: Chutes (production target — swap in when you get the key) ---
# CHUTES_API_KEY=cpk_...
# CHUTES_BASE_URL=https://llm.chutes.ai/v1
# CHUTES_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# CHUTES_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# EMBED_DIM=4096
